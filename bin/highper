#!/usr/bin/env php
<?php

declare(strict_types=1);

use HighPerApp\HighPer\CLI\Application;
use HighPerApp\HighPer\CLI\Commands\QueueWorkCommand;
use HighPerApp\HighPer\CLI\Commands\ScheduleRunCommand;

if (file_exists(__DIR__ . '/../../../autoload.php')) {
    require __DIR__ . '/../../../autoload.php';
} elseif (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require __DIR__ . '/../vendor/autoload.php';
} elseif (file_exists(__DIR__ . '/../../../../vendor/autoload.php')) {
    require __DIR__ . '/../../../../vendor/autoload.php';
} else {
    fwrite(STDERR, 'Install dependencies using Composer.');
    exit(1);
}

$app = new Application('HighPer CLI', '1.0.0');

// Queue worker commands
$app->add(new QueueWorkCommand());

// Scheduler commands
$app->add(new ScheduleRunCommand());

// Auto-discover application commands
if (file_exists(getcwd() . '/app/Commands')) {
    $app->discoverCommands(getcwd() . '/app/Commands');
}

$app->run();